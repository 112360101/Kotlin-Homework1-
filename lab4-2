package com.example.app

import android.app.Activity
import android.content.Intent
import android.os.Bundle
import android.widget.Button
import android.widget.EditText
import android.widget.RadioButton
import android.widget.RadioGroup
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity

class SecActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_sec)

        val edDrink = findViewById<EditText>(R.id.edDrink)
        val rgSugar = findViewById<RadioGroup>(R.id.rgSugar)
        val rgIce = findViewById<RadioGroup>(R.id.rgIce)
        val btnSend = findViewById<Button>(R.id.btnSend)

        btnSend.setOnClickListener {
            val drink = edDrink.text.toString()

            // 檢查是否輸入飲料名稱
            if (drink.isEmpty()) {
                Toast.makeText(this, "請輸入飲料名稱", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }

            // 取得選中的 RadioButton 文字
            val selectedSugar = findViewById<RadioButton>(rgSugar.checkedRadioButtonId)?.text.toString()
            val selectedIce = findViewById<RadioButton>(rgIce.checkedRadioButtonId)?.text.toString()

            // 將資料打包回傳
            val bundle = Bundle().apply {
                putString("drink", drink)
                putString("sugar", selectedSugar)
                putString("ice", selectedIce)
            }

            val intent = Intent().putExtras(bundle)
            setResult(Activity.RESULT_OK, intent)
            finish() // 關閉此 Activity 返回上一頁
        }
    }
}
